class_name InputBuffer extends RefCounted
## Буфер ввода. Нажатие, пришедшее на кадре, где действие ещё нельзя выполнить
## (идёт дэш, идёт hit-stop, не вышел кулдаун), не выбрасывается, а живёт `window`
## секунд и срабатывает в первый же разрешённый кадр.
##
## Без этого прототип читается как «управление подтормаживает», и владелец
## спишет на ползунки то, что на самом деле сделал потерянный ввод.
## Окно 0.15 c — середина диапазона, в котором держатся экшен-рогалики.

const WINDOW: float = 0.15

var _pressed_at: float = -1000.0
var _now: float = 0.0


## Зовётся каждый кадр: буфер живёт в игровом времени, а не в системном.
func tick(delta: float) -> void:
	_now += delta


func press() -> void:
	_pressed_at = _now


## Забирает нажатие, если оно ещё свежее. Повторно то же нажатие не отдаётся.
func consume() -> bool:
	if _now - _pressed_at > WINDOW:
		return false
	_pressed_at = -1000.0
	return true


func clear() -> void:
	_pressed_at = -1000.0
